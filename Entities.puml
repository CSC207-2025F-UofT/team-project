@startuml
'https://plantuml.com/class-diagram
' `..|>` represents Interface Realization/Implementation (dashed line with an open arrow).
' `--|>` represents Inheritance/Generalization (solid line with an open arrow).
' `o-->` represents Aggregation (a hollow diamond pointing to the owner/container). The "\*" indicates multiplicity (e.g., Drawing holds multiple Shape objects).
skinparam dpi 120
skinparam classAttributeIconSize 0
hide empty members

' ========
' Foundational entities
' ========

' The enumeration here must be properly ordered
enum DifficultyLevel {
  EASY
  AVERAGE
  DIFFICULT
  --
  -displayName: String
  --
  +getDisplayName(): String
  +toString(): String
}

enum SortingStrategy {
  BY_DUE_DATE
  BY_SUGGESTED_HOURS_TO_WORK_PER_DAY
  --
  -displayName: String
  --
  +getDisplayName(): String
  +toString(): String
}

abstract class BusinessMappings {
  + addMapping : Map<Object, Object>
}

' Maps with keys and values being both one-to-one and onto
abstract class BusinessOneToOneCorrespondenceMappings

' CA - Canada, US - USA, ET - Ethiopia, IN - India, FR - France, GH - Ghana
class CountryCodeAndCountryMappings {
  - countryNameToCountryCodeMapping : Map<String, String>
  - countryCodeToCountryNameMapping : Map<String, String>
  + getCountryCode(name : String) : String
  + getCountryNameMapping(code : String) : String
}

class TaskSortingStrategyNameMappings {
 - strategyNameToSortingStrategyMapping : Map<SortingStrategy, TaskSortingStrategy>
 - sortingStrategyToStrategyNameMapping : Map<TaskSortingStrategy, SortingStrategy>
 + getTaskSortingStrategy(name : SortingStrategy) : TaskSortingStrategy
 + getStrategyName(strategy : TaskSortingStrategy) : SortingStrategy
}

' The uniqueId is only unique per user
' The uniqueUserId reflects the user that owns the task
abstract class Task {
  - {final} uniqueTaskId : int
  - {final} uniqueUserId : int
  + getUniqueTaskId() : int
  + getUniqueUserId() : int
}

' The `fieldsValidation()` method checks the following in the fields of the StudentTask object:
' - The estimated number of hours needed to complete the task must be positive
' - The completion progress must be an integer between 0 and 100. Both 0 and 100 are allowed.
' - The `deadline` field cannot be empty, and it could be a date that has already passed.
' - The `uniqueUserId` field cannot be 0 (the default initializing value)
' - Neither the title nor the description can be null, although they can be empty string.
' - The difficulty level cannot be null
' The constructor of `StudentTask` should use the method `fieldsValidation()` to double-check the validity of the
'     object created, and throw an error if the item is not valid.
' The setter of `StudentTask` should use the method `fieldsValidation()` to double-check the validity of the object
'     before and after the fields are changed, and throw an error if the item is not valid.
' The `inputValidation()` method checks the following inputs, which may or may not be fields of the StudentTask object.
'     This method would be used in the setter methods of the following fields, before the changes, to prevent illegal
'     inputs from modifying these fields of the `StudentTask` object. In addition, this method can be used in the use
'     cases to prevent user entering bad data, corrupting the `StudentTask`.
' - The `deadline`
' - The `estimated number of hours`
' - The `completion progress`
' - The `difficultyLevel`
class StudentTask {
  - title : String
  - description : String
  - deadline : LocalDate
  - estimatedHoursToCompleteTask : double
  - completionProgress : byte
  - difficultyLevel : DifficultyLevel
  + fieldsValidation() : boolean
  + inputValidation(deadline : LocalDate, estimatedHours : double, progress : byte,
      difficultyLevel : DifficultyLevel) : boolean
}

abstract class User {
  - username : String
  - password : String
  - {final} uniqueUserId : int
}

abstract class TasksUser {
  - tasks : List<Task>
  + {final} taskFactory : TaskFactory
}

class StudentTasksUser {
  - countryCode : String
  + {final} studentTaskFactory : StudentUserFactory
}

abstract class TaskSortingStrategy<T extends Task> {
  + {abstract} sort(tasks : List<T>) : List<T>
}

class StudentTaskSortingStrategy {
  + sort(studentTasks : List<StudentTask>) : List<StudentTask>
}

' Country code is in ISO 3166-1 alpha-2 code
class Holidays {
  - countryCodeToHolidays: Map<String,Set<LocalDate>>
}

BusinessMappings <|-- BusinessOneToOneCorrespondenceMappings
BusinessOneToOneCorrespondenceMappings <|-- CountryCodeAndCountryMappings
BusinessOneToOneCorrespondenceMappings <|-- TaskSortingStrategyNameMappings

Task <|-- StudentTask

User <|-- TasksUser
TasksUser <|-- StudentTasksUser

Task <--o TasksUser

TaskSortingStrategy <|-- StudentTaskSortingStrategy

TaskSortingStrategy <--o TaskSortingStrategyNameMappings
DifficultyLevel <--o StudentTask
SortingStrategy <--o TaskSortingStrategyNameMappings

@enduml

@startuml
'https://plantuml.com/class-diagram
' `..|>` represents Interface Realization/Implementation (dashed line with an open arrow).
' `--|>` represents Inheritance/Generalization (solid line with an open arrow).
' `o-->` represents Aggregation (a hollow diamond pointing to the owner/container). The "\*" indicates multiplicity (e.g., Drawing holds multiple Shape objects).
skinparam dpi 120
skinparam classAttributeIconSize 0
hide empty members

' ========
' Factories
' ========

abstract class TasksUser

abstract class BusinessMappingsFactory {
  + createMapping() : BusinessMapping
}

abstract class BusinessOneToOneCorrespondenceMappingsFactory {
  + createMapping() : BusinessOneToOneCorrespondenceMapping
}

class CountryCodeAndCountryMappingsFactory {
  + createMapping() : CountryCodeAndCountryMapping
}

class StrategyToStrategyNameMappingsFactory {
  + createMapping() : StrategyToStrategyNameMapping
}

BusinessMappingsFactory <|-- BusinessOneToOneCorrespondenceMappingsFactory
BusinessOneToOneCorrespondenceMappingsFactory <|-- CountryCodeAndCountryMappingsFactory
BusinessOneToOneCorrespondenceMappingsFactory <|-- StrategyToStrategyNameMappingsFactory

abstract class UserFactory {
  - nextUniqueID : int
  + createUser() : User
}

abstract class TaskUserFactory {
  + createUser() : TaskUser
}

class StudentUserFactory {
  + createUser() : StudentUser
}

UserFactory <|-- TaskUserFactory
TaskUserFactory <|-- StudentUserFactory

abstract class TaskFactory {
  - nextUniqueID : int
  + createTask(uniqueUserId : String) : Task
}

class StudentTaskFactory {
  + createTask(uniqueUserId : String, title : String, description : String, deadline : LocalDate,
  estimatedHoursToCompleteTask : double, completionProgress : byte, difficultyLevel : DifficultyLevel) : StudentTask
}

TaskFactory <|-- StudentTaskFactory

abstract class TaskSortingStrategyFactory {
  + createStrategy() : TaskSortingStrategy
}

class StudentTaskSortingStrategyFactory {
  + createStrategy() : StudentTaskSortingStrategy
}

TaskSortingStrategyFactory <|-- StudentTaskSortingStrategyFactory

' The following TaskUser is a continuation from the PlantUML diagram described above
TaskFactory <--o TasksUser

@enduml