@startuml
'https://plantuml.com/sequence-diagram

autonumber

== "Turn on the Monitoring Window" ==
actor "Human Student User" as humanStudentUser
boundary "BaseView" as baseView
control "TurnOnMonitoringController" as turnOnMonitoringController
participant "TurnOnMonitoringInputBoundary <<Interface>>" as turnOnMonitoringInputBoundary
control "TurnOnMonitoringInteractor" as turnOnMonitoringInteractor
participant "TurnOnMonitoringOutputBoundary <<Interface>>" as turnOnMonitoringOutputBoundary
control "TurnOnMonitoringPresenter" as turnOnMonitoringPresenter
participant "TurnOnMonitoringViewModel" as turnOnMonitoringViewModel
participant "ViewModelManager" as viewModelManager
boundary "MonitoringView<MonitoringState>" as monitoringView

humanStudentUser -> baseView: Turn on the Monitoring Window
baseView -> turnOnMonitoringController: execute()
turnOnMonitoringController -> turnOnMonitoringInputBoundary: execute(MonitoringInputData)
turnOnMonitoringInputBoundary -> turnOnMonitoringInteractor: execute(MonitoringInputData)

ref over turnOnMonitoringInteractor: Use Case 3

turnOnMonitoringInteractor -> turnOnMonitoringOutputBoundary: prepareMonitoringView(MonitoringOutputData)
turnOnMonitoringOutputBoundary -> turnOnMonitoringPresenter: prepareMonitoringView(MonitoringOutputData)
turnOnMonitoringPresenter -> turnOnMonitoringViewModel: setState(monitoringState)
turnOnMonitoringPresenter <-- turnOnMonitoringViewModel
turnOnMonitoringPresenter -> turnOnMonitoringViewModel: firePropertyChange()
turnOnMonitoringViewModel -> monitoringView: propertyChange()
turnOnMonitoringPresenter <-- monitoringView
turnOnMonitoringPresenter -> viewModelManager: changeView("Monitoring")
viewModelManager -> monitoringView: switch("Monitoring")

@enduml