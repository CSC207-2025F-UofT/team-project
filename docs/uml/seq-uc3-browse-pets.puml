@startuml seq-uc3-browse-pets
title UC3 Browse and Filter Pets: sequence (choosing filters)

skinparam sequenceMessageAlign left
autonumber

actor Visitor
participant "GalleryView" as View
participant "BrowsePetsController" as Controller
participant "BrowsePetsInteractor\n<<BrowsePetsInputBoundary>>" as Interactor
participant "FilePetDataAccessObject\n<<BrowsePetsDataAccessInterface>>" as DAO
participant "BrowsePetsPresenter\n<<BrowsePetsOutputBoundary>>" as Presenter
participant "GalleryViewModel" as VM

Visitor -> View : opens the gallery and chooses\nage, temperament and health filters
View -> Controller : browse(age, temperaments,\nnoMedicalNeedsOnly)
Controller -> Controller : create AgeRangeFilter,\nTemperamentFilter, HealthNeedsFilter
Controller -> Interactor : execute(new BrowsePetsInputData(filters))

Interactor -> DAO : getAvailablePets()
DAO --> Interactor : AVAILABLE pets
Interactor -> Interactor : keep pets that match every filter
Interactor -> Presenter : presentPets(new BrowsePetsOutputData(pets))

loop for each pet
  Presenter -> Presenter : new PetCardData(name,\n"Cat, Tabby, 2 years old", status)
end
Presenter -> VM : setCards(cards)
VM -> View : property change "cards"
View -> View : show the pet cards
View --> Visitor : cards of the matching pets

note over Interactor, VM
  If no pet matches, the gallery says so
  and the visitor can clear the filters.
end note

@enduml
