@startuml uc5-submit-application
title UC5 Submit an Application: Clean Architecture classes

left to right direction
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 30
skinparam ranksep 60
hide empty members

package "View\n(Frameworks & Drivers)" as FDView #E2F4E2 {
  class SubmitApplicationView {
    + stateChanged() : void
  }
}

package "Interface Adapters" as IA #DDEBFF {
  class SubmitApplicationController {
    + execute(adopterId, petId, housingType,\n  petExperience, householdMembers,\n  contactInfo, note) : void
  }
  class SubmitApplicationPresenter {
    + prepareSuccessView(outputData) : void
    + prepareFailView(errorMessage) : void
  }
  class SubmitApplicationViewModel {
    + getState() : SubmitApplicationState
    + notifyStateChanged() : void
  }
  class SubmitApplicationState {
    adopterId, petId, petName
    error, successMessage
  }
  interface SubmitApplicationViewModelListener {
    + stateChanged() : void
  }
}

package "Application Business Rules" as ABR #FDE2E2 {
  interface SubmitApplicationInputBoundary {
    + execute(inputData) : void
  }
  class SubmitApplicationInputData {
    adopterId, petId, housingType,
    petExperience, householdMembers,
    contactInfo, note
  }
  class SubmitApplicationInteractor {
    + execute(inputData) : void
  }
  interface SubmitApplicationOutputBoundary {
    + prepareSuccessView(outputData) : void
    + prepareFailView(errorMessage) : void
  }
  class SubmitApplicationOutputData {
    applicationId, petName
  }
  interface SubmitApplicationDataAccessInterface {
    + hasActiveApplication(adopterId, petId) : boolean
    + save(application) : void
  }
  interface SubmitApplicationPetDataAccessInterface {
    + isAvailable(petId) : boolean
    + getPetName(petId) : String
  }
}

package "Enterprise Business Rules" as EBR #FFF4D6 {
  class Application
}

package "Data Access\n(Frameworks & Drivers)" as FDData #E2F4E2 {
  class FileApplicationDataAccessObject
  class InMemoryApplicationDataAccessObject
  class FilePetDataAccessObject
}

' View and view model
SubmitApplicationView --> SubmitApplicationController : calls
SubmitApplicationView --> SubmitApplicationViewModel : reads
SubmitApplicationView ..|> SubmitApplicationViewModelListener
SubmitApplicationViewModel --> SubmitApplicationState
SubmitApplicationViewModel --> SubmitApplicationViewModelListener : notifies

' Input side
SubmitApplicationController ..> SubmitApplicationInputData : creates
SubmitApplicationController --> SubmitApplicationInputBoundary
SubmitApplicationInputBoundary <|.. SubmitApplicationInteractor

' Output side
SubmitApplicationPresenter ..|> SubmitApplicationOutputBoundary
SubmitApplicationPresenter --> SubmitApplicationViewModel : updates
SubmitApplicationOutputBoundary <-- SubmitApplicationInteractor
SubmitApplicationOutputData <.. SubmitApplicationInteractor : creates

' Data access side
SubmitApplicationInteractor --> SubmitApplicationDataAccessInterface
SubmitApplicationInteractor --> SubmitApplicationPetDataAccessInterface
SubmitApplicationInteractor ..> Application : creates
SubmitApplicationDataAccessInterface <|.. FileApplicationDataAccessObject
SubmitApplicationDataAccessInterface <|.. InMemoryApplicationDataAccessObject
SubmitApplicationPetDataAccessInterface <|.. FilePetDataAccessObject
Application <.. FileApplicationDataAccessObject : saves / loads

note bottom of InMemoryApplicationDataAccessObject
  Used in tests only.
end note

@enduml
