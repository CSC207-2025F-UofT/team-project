@startuml uc1-signup-login
title UC1 Sign up / Admin Sign up / Log in: use case layer and data access (on main)

left to right direction
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 25
skinparam ranksep 60
hide empty members

package "Application Business Rules" as ABR #FDE2E2 {

  package "signup" #FFFFFF {
    interface SignupInputBoundary {
      + execute(inputData) : void
      + switchToLoginView() : void
    }
    class SignupInputData {
      username, id, email,
      password, repeatPassword
    }
    class SignupInteractor {
      + execute(inputData) : void
      + switchToLoginView() : void
    }
    interface SignupOutputBoundary {
      + prepareSuccessView(outputData) : void
      + prepareFailView(errorMessage) : void
      + switchToLoginView() : void
    }
    class SignupOutputData {
      username
    }
    interface SignupUserDataAccessInterface {
      + existsById(id) : boolean
      + existsByEmail(email) : boolean
      + save(user) : void
    }
  }

  package "admin_signup" #FFFFFF {
    interface AdminSignupInputBoundary {
      + execute(inputData) : void
      + switchToLoginView() : void
    }
    class AdminSignupInputData {
      username, id, email, password,
      repeatPassword, inviteCode
    }
    class AdminSignupInteractor {
      + execute(inputData) : void
      + switchToLoginView() : void
    }
    interface AdminSignupOutputBoundary {
      + prepareSuccessView(outputData) : void
      + prepareFailView(errorMessage) : void
      + switchToLoginView() : void
    }
    class AdminSignupOutputData {
      username
    }
    interface AdminSignupUserDataAccessInterface {
      + existsById(id) : boolean
      + existsByEmail(email) : boolean
      + save(user) : void
    }
    interface AdminInviteCodeChecker {
      + isValid(code) : boolean
    }
  }

  package "login" #FFFFFF {
    interface LoginInputBoundary {
      + execute(inputData) : void
    }
    class LoginInputData {
      email, password
    }
    class LoginInteractor {
      + execute(inputData) : void
    }
    interface LoginOutputBoundary {
      + prepareSuccessView(outputData) : void
      + prepareFailView(errorMessage) : void
    }
    class LoginOutputData {
      username, id, role
    }
    interface LoginUserDataAccessInterface {
      + getByEmail(email) : User
      + setCurrentUserId(id) : void
    }
  }
}

package "Enterprise Business Rules" as EBR #FFF4D6 {
  class User
  class UserFactory {
    + create(...) : User
  }
}

package "Data Access\n(Frameworks & Drivers)" as FDData #E2F4E2 {
  class FileUserDataAccessObject {
    users stored in a CSV file
  }
  class EnvAdminInviteCodeChecker {
    reads PAWPORTAL_ADMIN_INVITE_CODE
  }
}

SignupInputBoundary <|.. SignupInteractor
SignupInputData <.. SignupInteractor : reads
SignupOutputBoundary <-- SignupInteractor
SignupOutputData <.. SignupInteractor : creates
SignupInteractor --> SignupUserDataAccessInterface
SignupInteractor --> UserFactory

AdminSignupInputBoundary <|.. AdminSignupInteractor
AdminSignupInputData <.. AdminSignupInteractor : reads
AdminSignupOutputBoundary <-- AdminSignupInteractor
AdminSignupOutputData <.. AdminSignupInteractor : creates
AdminSignupInteractor --> AdminSignupUserDataAccessInterface
AdminSignupInteractor --> AdminInviteCodeChecker
AdminSignupInteractor --> UserFactory

LoginInputBoundary <|.. LoginInteractor
LoginInputData <.. LoginInteractor : reads
LoginOutputBoundary <-- LoginInteractor
LoginOutputData <.. LoginInteractor : creates
LoginInteractor --> LoginUserDataAccessInterface
LoginInteractor ..> User : checks password

UserFactory ..> User : creates
SignupUserDataAccessInterface <|.. FileUserDataAccessObject
AdminSignupUserDataAccessInterface <|.. FileUserDataAccessObject
LoginUserDataAccessInterface <|.. FileUserDataAccessObject
AdminInviteCodeChecker <|.. EnvAdminInviteCodeChecker
User <.. FileUserDataAccessObject : saves / loads

note bottom of FileUserDataAccessObject
  Controllers, presenters, view models and views
  for UC1 are not on main yet
  (they are on Carina's branch).
end note

@enduml
