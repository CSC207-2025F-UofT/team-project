@startuml uc3-browse-pets
title UC3 Browse and Filter Pets: Clean Architecture classes

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 50
hide empty members

package "Interface Adapters" as IA #DDEBFF {
  class BrowsePetsController {
    + browse(age : AgeFilterOption,\n  temperaments : Set<Temperament>,\n  noMedicalNeedsOnly : boolean) : void
  }
  class BrowsePetsPresenter {
    + presentPets(outputData) : void
  }
  class GalleryViewModel {
    + getCards() : List<PetCardData>
    + setCards(cards) : void
  }
  class PetCardData {
    name, summary, status
  }
  enum AgeFilterOption {
    ANY, UNDER_ONE, ONE_TO_THREE,
    FOUR_TO_SEVEN, EIGHT_PLUS
  }
}

package "Application Business Rules" as ABR #FDE2E2 {
  class BrowsePetsInputData {
    filters : List<PetFilter>
  }
  interface BrowsePetsInputBoundary {
    + execute(inputData) : void
  }
  interface BrowsePetsOutputBoundary {
    + presentPets(outputData) : void
  }
  class BrowsePetsOutputData {
    pets : List<Pet>
  }
  class BrowsePetsInteractor {
    + execute(inputData) : void
  }
  interface PetFilter {
    + matches(pet : Pet) : boolean
  }
  class AgeRangeFilter
  class TemperamentFilter
  class HealthNeedsFilter
  interface BrowsePetsDataAccessInterface {
    + getAvailablePets() : List<Pet>
  }
}

package "Enterprise Business Rules" as EBR #FFF4D6 {
  class Pet
  enum Temperament
  enum PetStatus
}

package "Frameworks & Drivers: View" as FDV #E2F4E2 {
  class GalleryView {
    + loadAll() : void
  }
}

package "Frameworks & Drivers: Data Access" as FDD #E2F4E2 {
  class FilePetDataAccessObject
}

IA -[hidden]right- ABR
ABR -[hidden]right- EBR
IA -[hidden]down- FDV
ABR -[hidden]down- FDD

BrowsePetsController -[hidden]down- BrowsePetsPresenter
BrowsePetsPresenter -down-> GalleryViewModel : updates
GalleryViewModel -right-> "0..*" PetCardData
BrowsePetsPresenter .right.> PetCardData : creates
AgeFilterOption -[hidden]up- BrowsePetsController
BrowsePetsController .left.> AgeFilterOption

BrowsePetsInputData -[hidden]down- BrowsePetsInputBoundary
BrowsePetsInputBoundary -[hidden]down- BrowsePetsOutputBoundary
BrowsePetsOutputBoundary -[hidden]down- BrowsePetsOutputData

BrowsePetsController -right-> BrowsePetsInputData : creates
BrowsePetsController -right-> BrowsePetsInputBoundary
BrowsePetsPresenter -right-|> BrowsePetsOutputBoundary
BrowsePetsPresenter .right.> BrowsePetsOutputData : reads

BrowsePetsInteractor -left-|> BrowsePetsInputBoundary
BrowsePetsInteractor .left.> BrowsePetsInputData : reads
BrowsePetsInteractor -left-> BrowsePetsOutputBoundary
BrowsePetsInteractor .left.> BrowsePetsOutputData : creates
BrowsePetsInteractor -down-> BrowsePetsDataAccessInterface
BrowsePetsInteractor -down-> PetFilter : applies every filter
AgeRangeFilter -up-|> PetFilter
TemperamentFilter -up-|> PetFilter
HealthNeedsFilter -up-|> PetFilter
BrowsePetsInteractor -right-> Pet
Pet -down-> Temperament
Pet -down-> PetStatus

GalleryView -up-> BrowsePetsController : calls
GalleryView -up-> GalleryViewModel : listens

FilePetDataAccessObject -up-|> BrowsePetsDataAccessInterface
FilePetDataAccessObject .up.> Pet : saves / loads

BrowsePetsPresenter -[#red,dashed]right-> Pet : skips use case layer

note bottom of FilePetDataAccessObject
  Also skipping the use case layer: BrowsePetsPresenter
  uses PetStatus, and BrowsePetsController and
  GalleryView use Temperament.
end note

@enduml
