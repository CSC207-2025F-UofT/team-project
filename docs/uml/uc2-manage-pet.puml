@startuml uc2-manage-pet
title UC2 Add / Edit / Remove a Pet: Clean Architecture classes

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 50
hide empty members

package "Interface Adapters" as IA #DDEBFF {
  class ManagePetController {
    + refresh() : void
    + add(name, species, breed, ageYears, sex, ...) : void
    + edit(id, name, species, breed, ageYears, sex, ...) : void
    + remove(id) : void
    + lookupBreed(name) : Optional<BreedReferenceViewData>
  }
  class ManagePetPresenter {
    + prepareSuccessView(outputData) : void
    + prepareFailView(message) : void
  }
  class ManagePetViewModel {
    + getPets() : List<PetViewData>
    + getAvailablePets() : List<PetViewData>
    + getMessage() : String
    + hasError() : boolean
  }
  class PetViewData {
    id, name, breed, ageYears, sex,
    temperamentTags, adoptionFee, status, ...
  }
  class BreedReferenceViewData {
    name, temperament, photo
  }
}

package "Application Business Rules" as ABR #FDE2E2 {
  class ManagePetInputData {
    name, species, breed, ageYears, sex,
    temperamentTags, healthNotes, needsMedication,
    vaccinated, spayedNeutered, adoptionFee, photoPath
  }
  interface ManagePetInputBoundary {
    + refresh() : void
    + add(inputData) : void
    + edit(petId, inputData) : void
    + remove(petId) : void
  }
  interface ManagePetOutputBoundary {
    + prepareSuccessView(outputData) : void
    + prepareFailView(message) : void
  }
  class ManagePetOutputData {
    pets : List<PetDetails>, message
  }
  class ManagePetInteractor
  interface ManagePetDataAccessInterface {
    + getPets() : List<Pet>
    + findById(id) : Pet
    + add(pet) : void
    + update(pet) : boolean
    + remove(id) : boolean
  }
  interface BreedLookupInputBoundary {
    + lookup(breedName) : Optional<BreedReference>
  }
  class BreedLookupInteractor
  class BreedReference {
    name, temperament, photo
  }
  interface BreedReferenceDataAccessInterface {
    + findByName(name) : Optional<BreedReference>
  }
}

package "Enterprise Business Rules" as EBR #FFF4D6 {
  class Pet
  enum Species
  enum PetSex
  enum PetStatus
  enum Temperament
}

package "Frameworks & Drivers: View" as FDV #E2F4E2 {
  class ManagePetView
  class PetForm
}

package "Frameworks & Drivers: Data Access" as FDD #E2F4E2 {
  class FilePetDataAccessObject
  class CatApiBreedDataAccess {
    calls TheCatAPI
  }
}

IA -[hidden]right- ABR
ABR -[hidden]right- EBR
IA -[hidden]down- FDV
ABR -[hidden]down- FDD

ManagePetController -[hidden]down- ManagePetPresenter
ManagePetPresenter -down-> ManagePetViewModel : updates
ManagePetViewModel -right-> "0..*" PetViewData
ManagePetController .down.> BreedReferenceViewData : creates

ManagePetInputData -[hidden]down- ManagePetInputBoundary
ManagePetInputBoundary -[hidden]down- ManagePetOutputBoundary
ManagePetOutputBoundary -[hidden]down- ManagePetOutputData
ManagePetOutputData -[hidden]down- BreedLookupInputBoundary

ManagePetController -right-> ManagePetInputData : creates
ManagePetController -right-> ManagePetInputBoundary
ManagePetController -right-> BreedLookupInputBoundary
ManagePetPresenter -right-|> ManagePetOutputBoundary
ManagePetPresenter .right.> ManagePetOutputData : reads

ManagePetInteractor -left-|> ManagePetInputBoundary
ManagePetInteractor .left.> ManagePetInputData : reads
ManagePetInteractor -left-> ManagePetOutputBoundary
ManagePetInteractor .left.> ManagePetOutputData : creates
ManagePetInteractor -down-> ManagePetDataAccessInterface
ManagePetInteractor -right-> Pet : creates

BreedLookupInteractor -left-|> BreedLookupInputBoundary
BreedLookupInteractor -down-> BreedReferenceDataAccessInterface
BreedLookupInteractor .left.> BreedReference : returns

Pet -down-> Species
Pet -down-> PetSex
Pet -down-> PetStatus
Pet -down-> Temperament

ManagePetView -up-> ManagePetController : calls
ManagePetView -up-> ManagePetViewModel : listens
PetForm -up-> ManagePetController : add / edit / look up breed

FilePetDataAccessObject -up-|> ManagePetDataAccessInterface
FilePetDataAccessObject .up.> Pet : saves / loads
CatApiBreedDataAccess -up-|> BreedReferenceDataAccessInterface

ManagePetViewModel -[#red,dashed]right-> Species : skips use case layer

note bottom of CatApiBreedDataAccess
  The breed lookup returns its result to the controller
  directly, without an output boundary and presenter.
  ManagePetViewModel also uses PetSex and Temperament.
end note

@enduml
